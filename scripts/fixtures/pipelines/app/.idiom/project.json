{
  "version": 1,
  "app": {
    "name": "Corner Table",
    "framework": "other"
  },
  "server": {
    "build": "node -e 0",
    "start": "node server.mjs",
    "readyUrl": "http://127.0.0.1:4317/",
    "port": 4317,
    "env": {
      "PORT": "4317"
    },
    "startupTimeoutMs": 60000
  },
  "viewports": [
    {
      "name": "desktop",
      "width": 1440,
      "height": 900
    },
    {
      "name": "mobile",
      "width": 390,
      "height": 844
    }
  ],
  "colorSchemes": ["light", "dark"],
  "capture": {
    "timezoneId": "America/New_York",
    "locale": "en-US",
    "reducedMotion": true,
    "fullPage": true,
    "settleMs": 250
  },
  "design": {
    "productFile": "PRODUCT.md",
    "designFile": "DESIGN.md"
  },
  "model": {
    "provider": "claude-code",
    "model": "claude-sonnet-5-5",
    "maxFindings": 5
  }
}
