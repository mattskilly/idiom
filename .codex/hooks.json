{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/process-command-guard.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
