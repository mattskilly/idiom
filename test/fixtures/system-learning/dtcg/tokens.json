{
  "spacing": {
    "$type": "dimension",
    "card": { "$value": { "value": 8, "unit": "px" } },
    "unused": { "$value": { "value": 24, "unit": "px" } },
    "alias": { "$value": "{spacing.card}" }
  },
  "radius": {
    "$type": "dimension",
    "button": { "$value": { "value": 6, "unit": "px" } },
    "unused": { "$value": { "value": 12, "unit": "px" } }
  },
  "button-height": {
    "$type": "dimension",
    "$value": { "value": 32, "unit": "px" }
  },
  "input-height": {
    "$type": "dimension",
    "$value": { "value": 40, "unit": "px" }
  },
  "color": {
    "$type": "color",
    "brand": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0705882353, 0.2039215686, 0.337254902]
      }
    },
    "unused": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.6705882353, 0.8039215686, 0.937254902]
      }
    },
    "alias": { "$value": "{color.brand}" }
  },
  "layout": { "$type": "dimension", "$value": { "value": 200, "unit": "px" } },
  "unknown": { "$value": "#123456" }
}
